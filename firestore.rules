rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.createdBy == request.auth.uid
          && resource.data.status == 'scheduled')
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['attendeesCount', 'averageRating', 'ratingsCount'])
      );
      allow delete: if false;

      match /rsvps/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.authorUid == request.auth.uid;
      }

      match /ratings/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid)
          && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy != request.auth.uid
          && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(uid))
          && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(uid)).data.status == 'going';
        allow delete: if isOwner(uid);
      }
    }

    // Collection-group reads. Nested matches above only authorize direct doc
    // reads and single-event collection queries; collectionGroup() requires
    // a top-level match. Each user can only query their own docs — the
    // matching where() filter in the client must be present or Firestore
    // rejects the query upfront.
    match /{path=**}/rsvps/{rsvpId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /{path=**}/ratings/{ratingId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
